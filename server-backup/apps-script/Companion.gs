/* Synthetic-only candidate. No trigger creation, console enrollment or broad Drive service. */
function pcCompanion(d) {
 var P=pcProtocol(d.crypto),c=d.config;
 function enabled(){if(c.mode!=='synthetic'||c.externalApproved!==true||!/^[a-z0-9]{20}$/.test(c.project||'')||![c.pullSecret,c.pushSecret].every(function(k){return typeof k==='string'&&k.length>=32})||c.pullSecret===c.pushSecret)P.fault('COMPANION_DISABLED')}
 function notice(status,id){if(!c.emailApproved)return false;d.notify({status:status,id:id||'none',at:d.now()});return true}
 function post(wire){enabled();var m=P.open(wire,c.pushSecret,d.now(),'journal.append');P.exact(m.data,['artifact']);var a=P.artifact(m.data.artifact);if(a.project!==c.project||a.kind!=='journal')P.fault('WRONG_ARCHIVE');var ack=d.store.appendJournal(a);return P.message('journal.append.result',ack,c.pushSecret,d.now(),m.nonce)}
 function manifest(wire){enabled();var m=P.open(wire,c.pushSecret,d.now(),'journal.manifest');P.exact(m.data,[]);var value=d.store.manifest();P.chain(value.items,value.head,c.project);return P.message('journal.manifest.result',{items:value.items,head:value.head,capturedAt:d.now(),project:c.project,publicationAllowed:false},c.pushSecret,d.now(),m.nonce)}
 function backup(){enabled();var id='none';try{var n=d.uuid(),request=P.message('backup.request',{},c.pullSecret,d.now(),n),reply=d.transport('/backup/request',request);var value=P.open(reply,c.pullSecret,d.now(),'backup.request.result',n).data;P.exact(value,['artifact']);var a=P.artifact(value.artifact);if(a.project!==c.project||a.kind!=='backup')P.fault('WRONG_ARCHIVE');id=a.id;var readback=d.store.putBackup(a);P.artifact(readback);if(readback.sha256!==a.sha256||readback.id!==a.id)P.fault('READBACK_FAILED');var v=d.uuid(),verified=P.open(d.transport('/backup/verify',P.message('backup.verify',{artifact:readback},c.pullSecret,d.now(),v)),c.pullSecret,d.now(),'backup.verify.result',v).data;if(verified.verified!==true||verified.id!==a.id||verified.sha256!==a.sha256)P.fault('DECRYPTION_UNVERIFIED');d.state.set('PC_LAST_SUCCESS',String(d.now()));d.state.set('PC_LAST_BACKUP_ID',id);try{notice('BACKUP_VERIFIED',id)}catch{d.state.set('PC_LAST_NOTIFICATION_FAILURE',String(d.now()));return {ok:true,emailDelivered:false,status:'NOTIFICATION_FAILED',id:id}}return {ok:true,status:'BACKUP_VERIFIED',id:id}}catch(error){try{notice('BACKUP_FAILED',id)}catch{}return {ok:false,status:'BACKUP_FAILED'}}}
 function watchdog(){enabled();var stamp=Number(d.state.get('PC_LAST_SUCCESS')||0),age=d.now()-stamp;if(!stamp||!Number.isFinite(age)||age>26*3600000||age< -120000){var previous=Number(d.state.get('PC_LAST_ALERT')||0);if(d.now()-previous>=3600000){try{if(notice('BACKUP_OVERDUE',null))d.state.set('PC_LAST_ALERT',String(d.now()))}catch{return {ok:false,status:'ALERT_FAILED'}}}return {ok:false,status:'BACKUP_OVERDUE'}}return {ok:true,status:'BACKUP_CURRENT'}}
 return {post:post,manifest:manifest,backup:backup,watchdog:watchdog};
}
function pcGoogleCrypto(){
 function hex(bytes){return bytes.map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2)}).join('')}
 return {sha256:function(v){return hex(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v))},hmac:function(v,k){return hex(Utilities.computeHmacSha256Signature(v,k))},decode:function(s){return Utilities.base64Decode(s)},encode:function(b){return Utilities.base64Encode(b)}};
}
function pcDriveStore(o){
 var P=pcProtocol(o.crypto),state=o.state;
 function safe(fn){try{return fn()}catch(e){P.fault('DRIVE_OPERATION_FAILED')}}
 function lock(fn){var l=LockService.getScriptLock();if(!l.tryLock(10000))P.fault('STORE_BUSY');try{return safe(fn)}finally{l.releaseLock()}}
 function folder(){var f=state.get('PC_FOLDER_ID');if(!/^[A-Za-z0-9_-]+$/.test(f||''))P.fault('STORE_NOT_INITIALIZED');return f}
 function list(kind){var rows=[],page;do{var r=Drive.Files.list({q:"'"+folder()+"' in parents and trashed = false and appProperties has { key='pcProject' and value='"+o.project+"' } and appProperties has { key='pcKind' and value='"+kind+"' }",fields:'nextPageToken,files(id,appProperties)',pageSize:1000,pageToken:page});rows=rows.concat(r.files||[]);page=r.nextPageToken;if(rows.length>20000)P.fault('JOURNAL_CAPACITY_EXCEEDED')}while(page);return rows}
 function read(f){var response=UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(f.id)+'?alt=media',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},followRedirects:false,muteHttpExceptions:true});if(response.getResponseCode()!==200)P.fault('DRIVE_READ_FAILED');var bytes=response.getBlob().getBytes(),p=f.appProperties;return P.artifact({id:p.pcId,kind:p.pcKind,project:p.pcProject,sha256:p.pcSha,bytes:Number(p.pcBytes),base64:o.crypto.encode(bytes)})}
 function write(a,r){var props={pcProject:a.project,pcKind:a.kind,pcId:a.id,pcSha:a.sha256,pcBytes:String(a.bytes)};if(r){props.pcSeq=String(r.seq);props.pcPrev=r.prev;props.pcHash=r.hash}return Drive.Files.create({name:'pc-'+a.kind+'-'+a.id+'.pcenc',parents:[folder()],mimeType:'application/octet-stream',appProperties:props},Utilities.newBlob(o.crypto.decode(a.base64),'application/octet-stream'),{fields:'id,appProperties'})}
 function journal(){var rows=list('journal').sort(function(a,b){return Number(a.appProperties.pcSeq)-Number(b.appProperties.pcSeq)}),items=rows.map(function(f){var a=read(f),p=f.appProperties;return {artifact:a,record:{id:a.id,kind:a.kind,project:a.project,sha256:a.sha256,bytes:a.bytes,seq:Number(p.pcSeq),prev:p.pcPrev,hash:p.pcHash}}});return items}
 function head(){var v=state.get('PC_JOURNAL_HEAD');if(!v)P.fault('MISSING_INDEPENDENT_HEAD');return JSON.parse(v)}
 return {
  putBackup:function(a){return lock(function(){P.artifact(a);if(a.kind!=='backup'||a.project!==o.project)P.fault('WRONG_ARCHIVE');var found=list('backup').filter(function(f){return f.appProperties.pcId===a.id});if(found.length>1)P.fault('DUPLICATE_OBJECT');var f=found[0]||write(a),back=read(f);if(['id','kind','project','sha256','bytes','base64'].some(function(k){return back[k]!==a[k]}))P.fault('ID_COLLISION');return back})},
  appendJournal:function(a){return lock(function(){P.artifact(a);if(a.kind!=='journal'||a.project!==o.project)P.fault('WRONG_ARCHIVE');var h=head(),items=journal();
   // A write may have completed just before execution stopped. Adopt ONLY one
   // fully verified extension; a gap, corruption or lost head blocks progress.
   if(items.length===h.seq+1){P.chain(items.slice(0,h.seq),h,o.project);var last=items[items.length-1],expected=P.record(last.artifact,h.seq+1,h.hash);if(JSON.stringify(last.record)!==JSON.stringify(expected))P.fault('BROKEN_JOURNAL');h={seq:expected.seq,hash:expected.hash};state.set('PC_JOURNAL_HEAD',JSON.stringify(h))}
   P.chain(items,h,o.project);var old=items.filter(function(x){return x.artifact.id===a.id});if(old.length){if(old.length!==1||old[0].artifact.sha256!==a.sha256)P.fault('ID_COLLISION');return {id:a.id,sha256:a.sha256,durable:true}}
   var rec=P.record(a,h.seq+1,h.hash),f=write(a,rec),back=read(f);if(['id','kind','project','sha256','bytes','base64'].some(function(k){return back[k]!==a[k]})||f.appProperties.pcSeq!==String(rec.seq)||f.appProperties.pcPrev!==rec.prev||f.appProperties.pcHash!==rec.hash)P.fault('READBACK_FAILED');state.set('PC_JOURNAL_HEAD',JSON.stringify({seq:rec.seq,hash:rec.hash}));return {id:a.id,sha256:a.sha256,durable:true}})},
  manifest:function(){return lock(function(){var items=journal(),h=head();P.chain(items,h,o.project);return {items:items,head:h}})}
 };
}
function pcProperties(){var p=PropertiesService.getScriptProperties();return {get:function(k){return p.getProperty(k)},set:function(k,v){p.setProperty(k,v)}}}
function pcConfiguration(state){return {mode:state.get('PC_MODE')||'disabled',externalApproved:state.get('PC_EXTERNAL_APPROVED')==='synthetic-only',emailApproved:state.get('PC_EMAIL_APPROVED')==='synthetic-only',scheduleApproved:state.get('PC_SCHEDULE_APPROVED')==='synthetic-only',project:state.get('PC_PROJECT_REF'),pullSecret:state.get('PC_PULL_SECRET'),pushSecret:state.get('PC_PUSH_SECRET'),ownerEmail:state.get('PC_OWNER_EMAIL'),baseUrl:state.get('PC_VERCEL_BASE_URL'),automationToken:state.get('PC_VERCEL_AUTOMATION_TOKEN')}}
function pcRuntime(){var state=pcProperties(),c=pcConfiguration(state),crypto=pcGoogleCrypto();if(c.mode!=='synthetic'||!c.externalApproved)throw Error('COMPANION_DISABLED');if(!/^[^\s@]+@[^\s@]+$/.test(c.ownerEmail||'')||Drive.About.get({fields:'user(emailAddress)'}).user.emailAddress.toLowerCase()!==c.ownerEmail.toLowerCase())throw Error('WRONG_GOOGLE_ACCOUNT');return pcCompanion({config:c,crypto:crypto,now:Date.now,uuid:function(){return Utilities.getUuid()},state:state,store:pcDriveStore({crypto:crypto,state:state,project:c.project}),notify:function(n){MailApp.sendEmail(c.ownerEmail,'PeaceCream backup: '+n.status,'Status: '+n.status+'\nRun: '+n.id+'\nUTC: '+new Date(n.at).toISOString())},transport:function(path,wire){return pcVercelTransport(c,path,wire)}})}
// The temporary project-wide token is sent only to this approved feature preview.
function pcVercelTransport(c,path,wire){
 if(!/^https:\/\/[a-z0-9-]+\.vercel\.app$/.test(c.baseUrl||'')||!['/backup/request','/backup/verify'].includes(path))throw Error('UNAPPROVED_ENDPOINT');
 var headers={};if(c.automationToken){if(c.baseUrl!=='https://peacecream-git-feature-anonymous-responses-peace-7909.vercel.app'||!/^[-A-Za-z0-9_]{32,256}$/.test(c.automationToken))throw Error('UNAPPROVED_AUTOMATION_TOKEN');headers['x-vercel-protection-bypass']=c.automationToken}
 var r=UrlFetchApp.fetch(c.baseUrl+'/api'+path,{method:'post',contentType:'application/json',headers:headers,payload:JSON.stringify(wire),followRedirects:false,muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('BACKUP_ENDPOINT_FAILED');var t=r.getContentText();if(t.length>4101000)throw Error('RESPONSE_TOO_LARGE');return JSON.parse(t);
}
function runSyntheticBackup(){try{return pcRuntime().backup()}catch{return pcUnavailable()}}
function scheduledBackup(){if(!pcConfiguration(pcProperties()).scheduleApproved)return {status:'SCHEDULE_DISABLED'};return runSyntheticBackup()}
function scheduledWatchdog(){if(!pcConfiguration(pcProperties()).scheduleApproved)return {status:'SCHEDULE_DISABLED'};try{return pcRuntime().watchdog()}catch{return pcUnavailable()}}
function doPost(e){try{if(!e||!e.postData||e.postData.type!=='application/json'||e.postData.contents.length>4101000)throw Error('INVALID_REQUEST');var wire=JSON.parse(e.postData.contents),state=pcProperties(),c=pcConfiguration(state),P=pcProtocol(pcGoogleCrypto()),action=JSON.parse(wire.payload).action,result;if(c.mode!=='synthetic'||!c.externalApproved||typeof c.pushSecret!=='string'||c.pushSecret.length<32||!['journal.append','journal.manifest'].includes(action))throw Error('COMPANION_DISABLED');P.open(wire,c.pushSecret,Date.now(),action);var runtime=pcRuntime();if(action==='journal.append')result=runtime.post(wire);else if(action==='journal.manifest')result=runtime.manifest(wire);else throw Error('INVALID_ACTION');return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON)}catch{return ContentService.createTextOutput('{"error":"COMPANION_REQUEST_FAILED"}').setMimeType(ContentService.MimeType.JSON)}}
function initializeSyntheticStore(){
 try{var state=pcProperties(),c=pcConfiguration(state),P=pcProtocol(pcGoogleCrypto());if(c.mode!=='synthetic'||!c.externalApproved||!/^[a-z0-9]{20}$/.test(c.project||'')||![c.pullSecret,c.pushSecret].every(function(k){return typeof k==='string'&&k.length>=32})||c.pullSecret===c.pushSecret)throw Error('SETUP_DISABLED');if(!c.ownerEmail||Drive.About.get({fields:'user(emailAddress)'}).user.emailAddress.toLowerCase()!==c.ownerEmail.toLowerCase())throw Error('WRONG_GOOGLE_ACCOUNT');var lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('STORE_BUSY');try{if(state.get('PC_FOLDER_ID')||state.get('PC_JOURNAL_HEAD'))throw Error('ALREADY_INITIALIZED');var f=Drive.Files.create({name:'PeaceCream synthetic encrypted backups',mimeType:'application/vnd.google-apps.folder',appProperties:{pcProject:c.project,pcKind:'root'}},null,{fields:'id'});state.set('PC_FOLDER_ID',f.id);state.set('PC_JOURNAL_HEAD',JSON.stringify({seq:0,hash:P.ZERO}));state.set('PC_OWNER_PIN',c.ownerEmail.toLowerCase());return {ok:true,status:'SYNTHETIC_STORE_INITIALIZED'}}finally{lock.releaseLock()}}catch{return {ok:false,status:'STORE_INITIALIZATION_FAILED'}}
}

function pcUnavailable(){var accepted=false;try{var state=pcProperties(),c=pcConfiguration(state);if(c.mode==='synthetic'&&c.externalApproved&&c.emailApproved&&c.ownerEmail&&state.get('PC_OWNER_PIN')===c.ownerEmail.toLowerCase()){MailApp.sendEmail(c.ownerEmail,'PeaceCream backup: COMPANION_UNAVAILABLE','Status: COMPANION_UNAVAILABLE\nUTC: '+new Date().toISOString());accepted=true}}catch{}return {ok:false,status:'COMPANION_UNAVAILABLE',notificationAccepted:accepted}}
